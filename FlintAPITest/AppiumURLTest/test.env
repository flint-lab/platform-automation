# Appium URL E2E Test Configuration
# Copy/fill before running. The NAT token is the token FlintAPI uses to
# authenticate you — it is sent as the Authorization header on every request.

# Base URL of the FlintAPI environment (include the Kong route prefix if any)
FLINT_BASE_URL=""

# Auth (NAT) token. Format: "Bearer <your-token>"
FLINT_AUTH_TOKEN="Bearer "

# Second identity — required only for tenant-isolation tests (TC-006, TC-014)
FLINT_AUTH_TOKEN_B="Bearer "

# Which surface to allocate from: emulator | physical
FLINT_SURFACE="emulator"
# Emulator: leave blank to auto-pick the first recipe from /list
FLINT_RECIPE_UUID=""
# Physical: required when FLINT_SURFACE=physical
FLINT_PHYSICAL_DEVICE_ID=""

# Thresholds (override as needed; no test hardcodes these)
FLINT_CONNECT_WINDOW_S="60"        # TC-002 time-to-ready
FLINT_IDLE_GRACE_S="300"           # TC-008 idle timeout
FLINT_GC_INTERVAL_S="120"          # TC-023 zombie sweep
FLINT_POOL_SIZE="5"                # TC-017 pool boundary
FLINT_CONCURRENCY_CAP="3"          # TC-016 per-tenant plan cap
FLINT_RATE_LIMIT_PER_SECOND="50"   # TC-027 burst threshold

# Observability (TC-030): metrics scrape endpoint, optional trace query
FLINT_METRICS_URL=""

# Staging-only fault commands (TC-010/019/022/025/028). Each case skips if unset.
FAULT_KILL_APPIUM=""
FAULT_NET_DROP=""
FAULT_DRAIN_NODE=""
FAULT_RESTART_CONTROL_PLANE=""
