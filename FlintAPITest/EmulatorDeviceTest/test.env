# FlintAPI Emulator E2E Test Configuration
# Copy this file to .env and fill in the values before running tests.

# Base URL of the FlintAPI environment to test against
# Examples:
#   https://staging.api.flintlab.io
#   https://preprod.api.flintlab.io
#   http://localhost:8023
FLINT_BASE_URL=""

# Personal Access Token for authentication
# Format: "Bearer <your-token>"
FLINT_AUTH_TOKEN="Bearer "


# (Optional) Absolute path to a valid .apk file for install tests
# Required only for TC-025 and TC-029 — those tests are auto-skipped if not set
FLINT_TEST_APK_PATH=
FLINT_TEST_UPLOAD_FILE_PATH=